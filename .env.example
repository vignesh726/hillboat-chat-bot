# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
PORT=3001

# Optional: force a specific vision model for images.
# Leave commented out and the server auto-picks one your account has.
# Current list: https://console.groq.com/docs/vision
# VISION_MODEL=qwen/qwen3.8-27b

# Optional: speech-to-text model for the mic button
# STT_MODEL=whisper-large-v3-turbo
